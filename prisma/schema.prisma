generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
}

model BootcampRegistration {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  fullName  String
  email     String   @unique
  age       Int
  gender    String
  whatsapp  String
  education String
  laptop    String
  track     String
  createdAt DateTime @default(now())
}

model Broadcast {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  subject        String
  body           String
  recipientCount Int
  createdAt      DateTime @default(now())
}
