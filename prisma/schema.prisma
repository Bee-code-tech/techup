generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

/// Roles: admin | tutor | student
model User {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  name               String
  email              String   @unique
  passwordHash       String
  role               String   @default("student")
  /// Student profile (null for admin/tutor unless filled)
  age                Int?
  gender             String?
  whatsapp           String?
  education          String?
  laptop             String?
  track              String?
  /// free | paid — controls paid-module + live eligibility
  accessTier         String   @default("free")
  mustChangePassword Boolean  @default(false)
  bio                String?
  avatarUrl          String?
  /// Learning streak (calendar days with activity)
  currentStreak      Int      @default(0)
  longestStreak      Int      @default(0)
  /// YYYY-MM-DD of last streak-qualifying activity (UTC)
  lastActivityDate   String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime? @updatedAt

  tutorTracks        TutorTrack[]
  coursesCreated     Course[]           @relation("CourseTutor")
  moduleProgress     ModuleProgress[]
  assignmentsCreated Assignment[]       @relation("AssignmentTutor")
  submissions        AssignmentSubmission[]
  liveSessions       LiveSession[]
  liveAttendance     LiveAttendance[]
  payments           Payment[]
  moduleUnlocks      ModuleUnlock[]
  passwordResets     PasswordResetToken[]
  notifications      Notification[]
  cohortEnrollments  CohortEnrollment[]
  scholarshipApps    ScholarshipApplication[]
  conversationsAsStudent Conversation[] @relation("ConversationStudent")
  conversationsAsTutor   Conversation[] @relation("ConversationTutor")
  messagesSent       Message[]
  certificates       Certificate[]
}

/// A tutor may be assigned to many tracks; a track may have many tutors.
model TutorTrack {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  tutorId   String   @db.ObjectId
  track     String
  createdAt DateTime @default(now())

  tutor User @relation(fields: [tutorId], references: [id])

  @@unique([tutorId, track])
  @@index([tutorId])
  @@index([track])
}

model Course {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  track       String
  title       String
  description String   @default("")
  /// Tigris (or CDN) cover image URL
  coverUrl    String?
  coverKey    String?
  order       Int      @default(0)
  tutorId     String   @db.ObjectId
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tutor   User     @relation("CourseTutor", fields: [tutorId], references: [id])
  modules Module[]
  assignments Assignment[]

  @@index([track])
  @@index([tutorId])
}

model Module {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  courseId      String   @db.ObjectId
  title         String
  description   String   @default("")
  /// Tigris secure/public URL
  videoUrl      String?
  /// Object key in Tigris (legacy name: videoPublicId)
  videoPublicId String?
  /// [{ name, url, key, format }]
  materials     Json?
  /// free | paid
  access        String   @default("free")
  order         Int      @default(0)
  passMark      Int      @default(70)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  course      Course                 @relation(fields: [courseId], references: [id])
  questions   QuizQuestion[]
  progress    ModuleProgress[]
  unlocks     ModuleUnlock[]
  liveSessionId String?  @db.ObjectId
  isLiveRecording Boolean @default(false)

  @@index([courseId])
  @@index([liveSessionId])
}

model QuizQuestion {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  moduleId        String   @db.ObjectId
  /// Question text (optional if promptImageUrl is set)
  prompt          String   @default("")
  promptImageUrl  String?
  promptImageKey  String?
  /// Option labels (may be empty when optionImageUrls[i] is set)
  options         String[]
  /// Parallel to options — public image URL or "" when none
  optionImageUrls String[] @default([])
  correctIndex    Int
  order           Int      @default(0)
  createdAt       DateTime @default(now())

  module Module @relation(fields: [moduleId], references: [id])

  @@index([moduleId])
}

model ModuleProgress {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  userId          String    @db.ObjectId
  moduleId        String    @db.ObjectId
  videoCompleted  Boolean   @default(false)
  quizPassed      Boolean   @default(false)
  quizScore       Int?
  quizAttempts    Int       @default(0)
  completedAt     DateTime?
  updatedAt       DateTime  @updatedAt
  createdAt       DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id])
  module Module @relation(fields: [moduleId], references: [id])

  @@unique([userId, moduleId])
  @@index([userId])
  @@index([moduleId])
}

model Assignment {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  /// course | track | module
  scope       String
  title       String
  description String    @default("")
  track       String
  courseId    String?   @db.ObjectId
  moduleId    String?   @db.ObjectId
  tutorId     String    @db.ObjectId
  /// When the assignment window opens (optional)
  opensAt     DateTime?
  dueAt       DateTime?
  maxScore    Int       @default(100)
  published   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tutor       User                   @relation("AssignmentTutor", fields: [tutorId], references: [id])
  course      Course?                @relation(fields: [courseId], references: [id])
  submissions AssignmentSubmission[]

  @@index([tutorId])
  @@index([track])
  @@index([courseId])
  @@index([published])
}

model AssignmentSubmission {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  assignmentId  String    @db.ObjectId
  userId        String    @db.ObjectId
  explanation   String    @default("")
  attachmentUrl String?
  attachmentKey String?
  /// pending | graded
  status        String    @default("pending")
  score         Int?
  tutorNote     String?
  reviewedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  assignment Assignment @relation(fields: [assignmentId], references: [id])
  user       User       @relation(fields: [userId], references: [id])

  @@unique([assignmentId, userId])
  @@index([assignmentId])
  @@index([userId])
  @@index([status])
}

model Notification {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @db.ObjectId
  /// assignment | grade | live | payment | course | system | alert | message
  type      String
  title     String
  body      String    @default("")
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model LiveSession {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  track       String
  tutorId     String    @db.ObjectId
  title       String    @default("Live class")
  /// zoom | meet | livekit
  platform    String
  joinUrl     String
  /// free | paid | both
  audience    String    @default("both")
  /// When the class is scheduled to start (nullable for legacy rows)
  scheduledAt DateTime? @default(now())
  isActive    Boolean   @default(true)
  endedAt     DateTime?
  /// idle | recording | ready | failed
  recordingStatus String @default("idle")
  egressId       String?
  recordingKey   String?
  recordingUrl   String?
  publishedModuleId String? @db.ObjectId
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tutor      User             @relation(fields: [tutorId], references: [id])
  attendance LiveAttendance[]

  @@index([track, isActive])
  @@index([tutorId])
  @@index([scheduledAt])
}

model LiveAttendance {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  sessionId String    @db.ObjectId
  userId    String    @db.ObjectId
  role      String
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?
  createdAt DateTime  @default(now())

  session LiveSession @relation(fields: [sessionId], references: [id])
  user    User        @relation(fields: [userId], references: [id])

  @@unique([sessionId, userId])
  @@index([sessionId])
  @@index([userId])
}

model Payment {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  userId            String   @db.ObjectId
  moduleId          String?  @db.ObjectId
  cohortId          String?  @db.ObjectId
  enrollmentId      String?  @db.ObjectId
  installmentId     String?  @db.ObjectId
  /// module | cohort_full | cohort_installment | scholarship_remnant
  kind              String   @default("module")
  amount            Int
  currency          String   @default("NGN")
  paystackReference String   @unique
  /// pending | success | failed
  status            String   @default("pending")
  couponCode        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([cohortId])
  @@index([enrollmentId])
  @@index([status])
}

model Cohort {
  id                           String    @id @default(auto()) @map("_id") @db.ObjectId
  name                         String
  description                  String    @default("")
  /// Full price in kobo
  priceKobo                    Int
  currency                     String    @default("NGN")
  /// draft | active | closed
  status                       String    @default("draft")
  tracks                       String[]
  scholarshipEnabled           Boolean   @default(true)
  /// 0-100 percent off full price
  scholarshipPercentOff        Int       @default(70)
  scholarshipConsentText       String    @default("I understand this scholarship covers 100% of tuition marketing value. I agree to pay the remaining configured commitment fee and certificate costs by the deadline, or forfeit my scholarship.")
  /// Days after award to pay remnant (null = no auto-remove)
  scholarshipDeadlineDays      Int       @default(14)
  installmentEnabled           Boolean   @default(true)
  installmentCount             Int       @default(3)
  /// Percents that must sum to 100, e.g. [40,30,30]
  installmentPercents          Int[]     @default([40, 30, 30])
  /// Days before each due date to email reminders, e.g. [3,1]
  installmentReminderDays      Int[]     @default([3, 1])
  /// Days overdue before enrollment is revoked
  installmentOverdueRemoveDays Int       @default(3)
  /// Spacing between installment due dates
  installmentIntervalDays      Int       @default(30)
  startsAt                     DateTime?
  endsAt                       DateTime?
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  coupons       Coupon[]
  enrollments   CohortEnrollment[]
  scholarships  ScholarshipApplication[]

  @@index([status])
}

model Coupon {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  code       String    @unique
  percentOff Int
  cohortId   String?   @db.ObjectId
  maxUses    Int?
  usedCount  Int       @default(0)
  expiresAt  DateTime?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  cohort Cohort? @relation(fields: [cohortId], references: [id])

  @@index([cohortId])
  @@index([isActive])
}

model ScholarshipApplication {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  cohortId        String    @db.ObjectId
  userId          String?   @db.ObjectId
  fullName        String
  email           String
  ageRange        String
  gender          String
  whatsapp        String
  country         String
  education       String
  referralSource  String
  track           String
  laptop          String
  internet        String
  dailyHours      String
  onlineBefore    String
  careerGoals     String
  consentAccepted Boolean   @default(false)
  /// awarded | revoked | expired | paid
  status          String    @default("awarded")
  percentOff      Int
  amountDueKobo   Int
  payDeadline     DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  cohort Cohort @relation(fields: [cohortId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])

  @@index([cohortId])
  @@index([email])
  @@index([status])
  @@index([userId])
}

model CohortEnrollment {
  id                       String   @id @default(auto()) @map("_id") @db.ObjectId
  userId                   String   @db.ObjectId
  cohortId                 String   @db.ObjectId
  track                    String
  /// full | installment | scholarship
  paymentType              String
  status                   String   @default("active")
  scholarshipApplicationId String?  @db.ObjectId
  couponCode               String?
  totalDueKobo             Int
  amountPaidKobo           Int      @default(0)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  user         User                  @relation(fields: [userId], references: [id])
  cohort       Cohort                @relation(fields: [cohortId], references: [id])
  installments InstallmentSchedule[]

  @@unique([userId, cohortId])
  @@index([cohortId])
  @@index([userId])
  @@index([status])
}

model InstallmentSchedule {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  enrollmentId  String    @db.ObjectId
  index         Int
  percent       Int
  amountKobo    Int
  dueAt         DateTime
  /// pending | paid | overdue | waived
  status        String    @default("pending")
  paidAt        DateTime?
  paymentId     String?   @db.ObjectId
  remindersSent Int[]     @default([])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  enrollment CohortEnrollment @relation(fields: [enrollmentId], references: [id])

  @@index([enrollmentId])
  @@index([dueAt, status])
}

model ModuleUnlock {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  moduleId  String   @db.ObjectId
  paymentId String?  @db.ObjectId
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  module Module @relation(fields: [moduleId], references: [id])

  @@unique([userId, moduleId])
  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @db.ObjectId
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([tokenHash])
}

/// Legacy CRM list — kept in sync for broadcasts during transition.
model BootcampRegistration {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  fullName  String
  email     String   @unique
  age       Int
  gender    String
  whatsapp  String
  education String
  laptop    String
  track     String
  createdAt DateTime @default(now())
}

model Broadcast {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  /// Optional for legacy rows created before campaign tracking.
  campaignKey    String?
  subject        String
  heading        String?  @default("")
  body           String
  ctaLabel       String?  @default("")
  ctaUrl         String?  @default("")
  tracks         String[] @default([])
  recipientCount Int
  skippedCount   Int?     @default(0)
  createdAt      DateTime @default(now())

  @@index([campaignKey])
}

model BroadcastDelivery {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  broadcastId    String   @db.ObjectId
  campaignKey    String
  registrationId String   @db.ObjectId
  email          String
  status         String
  createdAt      DateTime @default(now())

  @@unique([campaignKey, email])
  @@index([campaignKey])
  @@index([broadcastId])
}

model SiteSettings {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  key               String   @unique
  whatsappGroupUrl  String?
  whatsappGroupUrls Json?
  updatedAt         DateTime @updatedAt
}

/// One DM thread between a student and a tutor (usually same track).
model Conversation {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  studentId       String    @db.ObjectId
  tutorId         String    @db.ObjectId
  track           String
  lastMessageAt   DateTime?
  lastMessageText String?
  studentUnread   Int       @default(0)
  tutorUnread     Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  student  User      @relation("ConversationStudent", fields: [studentId], references: [id])
  tutor    User      @relation("ConversationTutor", fields: [tutorId], references: [id])
  messages Message[]

  @@unique([studentId, tutorId])
  @@index([tutorId, lastMessageAt])
  @@index([studentId, lastMessageAt])
  @@index([track])
}

model Message {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  conversationId String    @db.ObjectId
  senderId       String    @db.ObjectId
  /// text | image | file | audio | video
  kind           String    @default("text")
  body           String    @default("")
  /// Public media URL (Tigris)
  mediaUrl       String?
  mediaKey       String?
  mediaName      String?
  mediaMime      String?
  mediaSize      Int?
  /// Duration in seconds for audio/video
  mediaDuration  Int?
  createdAt      DateTime  @default(now())
  readAt         DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id])
  sender       User         @relation(fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model Certificate {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  userId        String   @db.ObjectId
  courseId      String   @db.ObjectId
  studentName   String
  courseTitle   String
  tutorName     String?
  /// Public verification-style code (download only; no public page)
  code          String   @unique
  completedAt   DateTime
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}
